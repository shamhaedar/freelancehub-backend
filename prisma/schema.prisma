// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  HOLD
  PAYOUT
  COMMISSION
  REFUND
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  isBanned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  profile   FreelancerProfile?
  wallet    Wallet?
  projects  Project[]  @relation("ProjectOwner")
  proposals Proposal[]
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FreelancerProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  imageUrl   String?
  bio        String?
  hourlyRate Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Project {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  budget       Decimal       @db.Decimal(12, 2)
  attachmentUrl String?
  status       ProjectStatus @default(OPEN)
  escrowAmount Decimal       @default(0) @db.Decimal(12, 2)
  ownerId      Int
  categoryId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner    User     @relation("ProjectOwner",fields: [ownerId],references: [id],onDelete: Restrict)
  category Category @relation(fields: [categoryId],references: [id],onDelete: Restrict)

  proposals Proposal[]
  transactions Transaction[]
  delivery  Delivery?

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([ownerId, status])
}

model Proposal {
  id           Int            @id @default(autoincrement())
  projectId    Int
  freelancerId Int
  price        Decimal        @db.Decimal(12, 2)
  durationDays Int
  message      String
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project    Project @relation(fields: [projectId],references: [id],onDelete: Cascade)
  freelancer User    @relation(fields: [freelancerId],references: [id],onDelete: Restrict)

  @@unique([freelancerId, projectId])
  @@index([projectId, status])
  @@index([freelancerId, status])
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  transactions Transaction[]
}

model Transaction {
  id        Int             @id @default(autoincrement())
  walletId  Int?
  projectId Int?  
  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())

  wallet Wallet? @relation(fields: [walletId],references: [id],onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
}

model Delivery {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique
  fileUrl   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId],references: [id],onDelete: Cascade)
}
